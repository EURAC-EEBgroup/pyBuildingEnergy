        "cooling_enabled": false,
        "demand_unit": "kWh",
        "backup_mode": "part_parallel",
        "hp_cutoff_temperature_C": 0.0,
        "hp_min_source_temperature_C": -15.0,
        "utility_cutoff_hours_per_day": 2.0,
        "heating_performance_map": "@air_to_water_heating_map"
      }
    },

    "no_backup_strict": {
      "description": "No backup: anything the HP cannot deliver is reported as unmet (useful for sizing checks).",
      "config": {
        "source_type": "air",
        "cooling_enabled": false,
        "dhw_enabled": false,
        "demand_unit": "kWh",
        "backup_mode": "none",
        "heating_performance_map": "@air_to_water_heating_map"
      }
    },

    "brine_to_water_ground_source": {
      "description": "Ground-source (brine/water) HP with constant 6 degC source.",
      "config": {
        "source_type": "ground",
        "ground_source_temperature_C": 6.0,
        "cooling_enabled": false,
        "demand_unit": "kWh",
        "part_load_unit_type": "brine-to-water",
        "heating_performance_map": "@ground_heating_map"
      }
    },

    "water_to_water_groundwater": {
      "description": "Groundwater HP: 12 degC source.",
      "config": {
        "source_type": "groundwater",
        "water_source_temperature_C": 12.0,
        "cooling_enabled": false,
        "demand_unit": "kWh",
        "part_load_unit_type": "water-to-water",
        "heating_performance_map": "@ground_heating_map"
      }
    },

    "exhaust_air_dhw_only": {
      "description": "Exhaust-air HP dedicated to DHW: heating and cooling switched off.",
      "config": {
        "source_type": "exhaust_air",
        "exhaust_air_temperature_C": 21.0,
        "heating_enabled": false,
        "cooling_enabled": false,
        "demand_unit": "kWh",
        "dhw_target_temperature_C": 55.0,
        "dhw_sink_temperature_C": 55.0,
        "dhw_storage_loss_kWh_per_day": 2.0,
        "heating_performance_map": "@air_to_water_heating_map"
      }
    },

    "independent_services_with_buffer": {
      "description": "Independent heating and DHW runtime (dual circuit) with buffer tank losses.",
      "config": {
        "source_type": "air",
        "cooling_enabled": false,
        "demand_unit": "kWh",
        "combined_operation": "independent",
        "heating_storage_loss_kWh_per_day": 1.2,
        "dhw_storage_loss_kWh_per_day": 1.8,
        "storage_test_deltaT_K": 45.0,
        "storage_ambient_temperature_C": 18.0,
        "storage_location_b_factor": 0.5,
        "heating_performance_map": "@air_to_water_heating_map"
      }
